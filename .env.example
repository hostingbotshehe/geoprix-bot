# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
# Optional: a server ID for instant command registration while testing
GUILD_ID=
# Optional: download link for the XAPK, shown in the installation post
XAPK_URL=
# Optional: channel that gets the installation post from /webhook-1 (default: #moddable-download)
INSTALL_CHANNEL_ID=
# Optional: role given to every member (default: @Member)
MEMBER_ROLE_ID=
